{# Links come from src/_data/nav.json. Adding a page is a data edit, not a template edit. #}
<div class="container is-max-widescreen">
    <nav class="navbar is-spaced is-transparent has-shadow" role="navigation" aria-label="main navigation">
        <div class="navbar-brand">
            <a class="navbar-item" href="/"><strong>Hogle Lab @ University of Turku</strong></a>
            {# data-target of navbar burger must be the id of the navbar-menu. in our case below "navMenu" #}
            <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navMenu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>

        <div class="navbar-menu" id="navMenu">
            {# navbar-end ensures navbar items are on the right side #}
            <div class="navbar-end">
                {% for item in nav %}
                    {% if item.children %}
                        <div class="navbar-item has-dropdown is-hoverable">
                            <a class="navbar-link">{{ item.label }}</a>
                            <div class="navbar-dropdown is-right is-boxed">
                                {% for child in item.children %}
                                    <a href="{{ child.url }}" class="navbar-item{{ ' is-active' if page.url == child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.label }}</a>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ item.url }}" class="navbar-item{{ ' is-active' if page.url == item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </nav>
</div>
