---
title: "Publication highlights"
description: "Selected research highlights from the Hogle Lab on microbial ecology, evolution, and biogeochemistry."
---
{#
    Rendered from src/_data/highlights.json. Each entry controls its own layout
    via imageSide ("left"/"right"), imageColumn/textColumn (Bulma column widths)
    and imageRatio (Bulma figure aspect ratio).
#}
{% macro figure(item) %}
<div class="column {{ item.imageColumn }}">
    <figure class="image {{ item.imageRatio }}">
        <img src="{{ item.image }}" alt="{{ item.alt }}"/>
    </figure>
</div>
{% endmacro %}

{% macro prose(item) %}
<div class="column {{ item.textColumn }}">
    <p class="title is-size-5">{{ item.title }}</p>
    <p class="content is-size-6">{{ item.summary | safe }}</p>
    <p class="content is-size-6">{{ item.citation | safe }}</p>
    <p><a target="_blank" rel="noopener" href="https://doi.org/{{ item.doi }}"><b>Read the publication</b></a></p>
</div>
{% endmacro %}

<section class="section">
    <div class="container is-max-widescreen">
        <div class="column">
            <p class="is-size-3 has-text-weight-bold mb-6">Group highlights</p>
            {% for item in highlights %}
            {% if not loop.first %}<hr>{% endif %}
            <div class="block">
                <div class="columns">
                    {% if item.imageSide == "left" %}
                        {{ figure(item) }}
                        {{ prose(item) }}
                    {% else %}
                        {{ prose(item) }}
                        {{ figure(item) }}
                    {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
